{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "vite-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "chat-harness",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/chat-dev-server.mjs"
      ],
      "port": 8787
    },
    {
      "name": "remotion-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "launch-video",
        "run",
        "dev",
        "--",
        "--port",
        "3000",
        "--no-open"
      ],
      "port": 3000
    }
  ]
}
