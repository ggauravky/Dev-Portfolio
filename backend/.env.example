# Backend environment variables for Render
# These will be set in Render Dashboard → Environment → Environment Variables

# REQUIRED: MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Server configuration
PORT=5000
NODE_ENV=production

# REQUIRED: Your frontend URL (will be provided by Vercel after deployment)
FRONTEND_URL=https://your-app-name.vercel.app

# Razorpay Standard Checkout (server-side only; use test keys locally)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_your_public_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_a_separate_webhook_secret

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Google Identity Services authentication (server-authoritative public client ID)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
AUTH_JWT_SECRET=replace_with_a_long_random_secret
AUTH_SESSION_TTL_SECONDS=604800
# Optional comma-separated exact origins for approved preview/custom domains.
AUTH_ALLOWED_ORIGINS=
# Vercel frontend + Render backend are cross-site, so production defaults to none.
# Set to lax only after frontend and backend are deployed on the same site.
AUTH_COOKIE_SAME_SITE=none
AUTH_RATE_LIMIT_MAX=20
BLOG_SUPPORT_RATE_LIMIT_MAX=80

# Brevo SMTP transactional emails (SMTP Login and SMTP Key, not an API key)
EMAIL_ENABLED=true
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
BREVO_SENDER_EMAIL=kumar.gaurav.yadav2007@gmail.com
BREVO_SENDER_NAME=Gaurav Kumar Yadav
BREVO_REPLY_TO_EMAIL=kumar.gaurav.yadav2007@gmail.com
BREVO_REPLY_TO_NAME=Gaurav Kumar Yadav
PAYMENT_EMAIL_NOTIFICATIONS_ENABLED=true
PAYMENT_ADMIN_EMAIL=kumar.gaurav.yadav2007@gmail.com
PAYMENT_EMAIL_MAX_ATTEMPTS=3
PAYMENT_EMAIL_RETRY_BASE_MS=1000
LOGIN_EMAIL_MAX_ATTEMPTS=3
LOGIN_EMAIL_RETRY_BASE_MS=2000
TEST_EMAIL_TO=gkumaryadav526@gmail.com
EMAIL_APP_NAME=Gaurav Kumar Portfolio
EMAIL_SUPPORT_URL=https://your-app-name.vercel.app/contact
EMAIL_BLOG_URL=https://your-app-name.vercel.app/blog
# Cloudinary user avatars (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=dev-portfolio/user-avatars
