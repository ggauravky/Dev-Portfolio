{
    "openapi": "3.0.3",
    "info": {
        "title": "Gaurav Kumar Yadav — Portfolio API",
        "description": "Public, read-only discovery endpoints for the developer portfolio of Gaurav Kumar Yadav (ggauravky): an LLM knowledge base in Markdown, a content-negotiated content endpoint, the sitemap, and this specification. There is no chat or write API.",
        "version": "1.0.0",
        "contact": {
            "name": "Gaurav Kumar Yadav",
            "email": "kumar.gaurav.yadav2007@gmail.com",
            "url": "https://ggauravky.vercel.app/contact"
        },
        "license": {
            "name": "All Rights Reserved",
            "url": "https://github.com/ggauravky/Dev-Portfolio/blob/main/LICENSE"
        }
    },
    "externalDocs": {
        "description": "LLM Knowledge Base (Markdown)",
        "url": "https://ggauravky.vercel.app/llms-full.txt"
    },
    "servers": [
        {
            "url": "https://ggauravky.vercel.app",
            "description": "Production (Vercel)"
        },
        {
            "url": "http://localhost:5173",
            "description": "Local development (Vite)"
        }
    ],
    "tags": [
        {
            "name": "discovery",
            "description": "Machine-readable discovery resources for agents and crawlers"
        }
    ],
    "paths": {
        "/api/content": {
            "get": {
                "operationId": "getContent",
                "summary": "Full knowledge base, content-negotiated",
                "description": "Serves public/llms-full.txt. With Accept: text/markdown or text/plain the raw Markdown is returned; otherwise a short JSON summary with links. CORS is open (Access-Control-Allow-Origin: *) and the response varies on Accept. Methods other than GET and OPTIONS return 405.",
                "tags": [
                    "discovery"
                ],
                "parameters": [
                    {
                        "name": "Accept",
                        "in": "header",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "text/markdown"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Markdown knowledge base, or a JSON summary",
                        "content": {
                            "text/markdown": {
                                "schema": {
                                    "type": "string"
                                }
                            },
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "title": {
                                            "type": "string"
                                        },
                                        "description": {
                                            "type": "string"
                                        },
                                        "markdown_url": {
                                            "type": "string",
                                            "format": "uri"
                                        },
                                        "openapi_url": {
                                            "type": "string",
                                            "format": "uri"
                                        },
                                        "mcp_url": {
                                            "type": "string",
                                            "format": "uri"
                                        },
                                        "note": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "405": {
                        "description": "Method not allowed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Content file could not be read",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/github-activity": {
            "get": {
                "operationId": "getGitHubActivity",
                "summary": "Last-year GitHub contribution count",
                "description": "The count shown in the site hero and footer for github.com/ggauravky: contributions in the last year, the day the count runs to (asOf), the last day with a contribution (lastActive) and when it was fetched (updatedAt). CDN-cached for 30 minutes and served stale while it revalidates; an upstream failure returns 502 and is never cached. Supports If-None-Match (304).",
                "tags": [
                    "discovery"
                ],
                "responses": {
                    "200": {
                        "description": "Current value",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "count",
                                        "asOf",
                                        "lastActive",
                                        "updatedAt"
                                    ],
                                    "properties": {
                                        "count": {
                                            "type": "integer",
                                            "minimum": 0
                                        },
                                        "asOf": {
                                            "type": "string",
                                            "format": "date"
                                        },
                                        "lastActive": {
                                            "type": "string",
                                            "nullable": true,
                                            "format": "date"
                                        },
                                        "updatedAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "source": {
                                            "type": "string",
                                            "enum": [
                                                "github-graphql",
                                                "contributions-api"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "304": {
                        "description": "Unchanged since the ETag sent in If-None-Match"
                    },
                    "502": {
                        "description": "Every upstream failed; nothing was cached"
                    }
                }
            }
        },
        "/llms.txt": {
            "get": {
                "operationId": "getLlmsTxt",
                "summary": "Retrieve the concise LLM knowledge base",
                "description": "Returns a Markdown-formatted document suitable for LLMs and AI agents. Contains identity, technical expertise, featured projects, services, blog links, and external profiles of Gaurav Kumar Yadav. Follows the llms.txt specification (https://llmstxt.org).",
                "tags": [
                    "discovery"
                ],
                "responses": {
                    "200": {
                        "description": "Markdown knowledge base",
                        "headers": {
                            "Vary": {
                                "schema": {
                                    "type": "string"
                                },
                                "description": "Accept"
                            }
                        },
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            },
                            "text/markdown": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/llms-full.txt": {
            "get": {
                "operationId": "getLlmsFullTxt",
                "summary": "Retrieve the full extended LLM knowledge base",
                "description": "Returns a comprehensive Markdown document with full project catalog (26 projects), detailed skill matrix, all services, blog articles, journey milestones, and direct navigation index. Preferred for agents that need complete portfolio context.",
                "tags": [
                    "discovery"
                ],
                "responses": {
                    "200": {
                        "description": "Full Markdown knowledge base",
                        "headers": {
                            "Vary": {
                                "schema": {
                                    "type": "string"
                                },
                                "description": "Accept"
                            }
                        },
                        "content": {
                            "text/plain": {
                                "schema": {
                                    "type": "string"
                                }
                            },
                            "text/markdown": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/sitemap.xml": {
            "get": {
                "operationId": "getSitemap",
                "summary": "Retrieve the XML sitemap",
                "description": "Returns a standard XML sitemap listing all publicly accessible pages, projects, and blog posts on the portfolio. Auto-generated at build time.",
                "tags": [
                    "discovery"
                ],
                "responses": {
                    "200": {
                        "description": "XML sitemap",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/openapi.json": {
            "get": {
                "operationId": "getOpenApiSpec",
                "summary": "Retrieve this OpenAPI specification",
                "description": "Returns this OpenAPI 3.0 specification document describing all public API endpoints of the portfolio.",
                "tags": [
                    "discovery"
                ],
                "responses": {
                    "200": {
                        "description": "OpenAPI 3.0 specification",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/.well-known/mcp.json": {
            "get": {
                "operationId": "getMcpManifest",
                "summary": "Retrieve the MCP server manifest",
                "description": "Returns the Model Context Protocol (MCP) manifest describing AI capabilities and tools available from this portfolio. Agents can use this to discover how to interact with the portfolio AI assistant.",
                "tags": [
                    "discovery"
                ],
                "responses": {
                    "200": {
                        "description": "MCP manifest JSON",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/resume.pdf": {
            "get": {
                "operationId": "getResume",
                "summary": "Download the portfolio owner's resume",
                "description": "Downloads the latest PDF resume of Gaurav Kumar Yadav.",
                "tags": [
                    "discovery"
                ],
                "responses": {
                    "200": {
                        "description": "PDF resume",
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ErrorResponse": {
                "type": "object",
                "description": "Standard error response",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "error": {
                        "type": "object",
                        "properties": {
                            "code": {
                                "type": "string",
                                "description": "Machine-readable error code",
                                "example": "NOT_FOUND"
                            },
                            "message": {
                                "type": "string",
                                "description": "Human-readable error description",
                                "example": "The requested resource was not found."
                            },
                            "docs": {
                                "type": "string",
                                "description": "Link to API documentation",
                                "example": "/openapi.json"
                            }
                        }
                    }
                }
            }
        }
    }
}
